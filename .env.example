# Runtime
XRL_HVAC_ENV=development
XRL_HVAC_LOG_LEVEL=INFO
XRL_HVAC_SEED=42
XRL_HVAC_DEVICE=auto

# Backend
XRL_HVAC_API_HOST=127.0.0.1
XRL_HVAC_API_PORT=8000
XRL_HVAC_CORS_ORIGINS=http://localhost:3000

# Demo defaults
XRL_HVAC_DEFAULT_SCENARIO=normal
XRL_HVAC_DEFAULT_CONTROLLER=fixed_thermostat

# Frontend (copied to frontend/.env.local when needed)
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
